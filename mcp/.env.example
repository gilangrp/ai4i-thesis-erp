# ---- Domain untuk HTTPS (Caddy) ----
DOMAIN=mcp.contoh.com

# ---- MCP server ----
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Buat dengan: openssl rand -hex 32
MCP_AUTH_TOKEN=ganti_dengan_token_acak_panjang
# Hanya untuk tes lokal tanpa token. Jangan true di produksi.
ALLOW_NO_AUTH=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

# ---- PostgreSQL ----
# Jika Postgres di host VPS yang sama dan MCP berjalan di Docker:
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=nama_database
POSTGRES_USER=mcp_machine_operation_readonly
POSTGRES_PASSWORD=ganti_dengan_password_yang_kuat
# Gunakan require/verify-full bila DB tidak berada di mesin yang sama.
POSTGRES_SSLMODE=prefer

# ---- Tabel & kolom (isi setelah skema diketahui) ----
TABLE_SCHEMA=public
TABLE_NAME=machine_operation
# Kolom untuk pengurutan (mis. created_at / id). Kosong = tanpa ORDER BY.
ORDER_BY_COLUMN=
ORDER_DIRECTION=DESC
# Kolom tanggal/timestamp untuk filter per tanggal. Kosong = tool by_date nonaktif.
DATE_COLUMN=

# ---- Batas query ----
DEFAULT_LIMIT=50
MAX_LIMIT=200
STATEMENT_TIMEOUT_MS=15000
